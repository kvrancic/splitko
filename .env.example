# Pexels (server-side only).
PEXELS_API_KEY=

# Supabase — use the NEW publishable / secret key format
# (Sept 2024 changeover, see https://github.com/orgs/supabase/discussions/29260).
# Find these in your Supabase dashboard → Settings → API → API keys (new).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. NEVER NEXT_PUBLIC_, never imported into client code.
# Optional — only needed if you add server-side admin operations later
# (the current demo flows don't use it).
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy variable names are still accepted by the app code, so both work:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy alias for the publishable key)
#   SUPABASE_SERVICE_ROLE_KEY     (legacy alias for the secret key)
